// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            "alt-o": "file_finder::Toggle",
            "alt-f o": [
                "projects::OpenRecent",
                {
                    "create_new_window": false
                }
            ],
            "alt-k": "workspace::ActivatePaneUp",
            "alt-j": "workspace::ActivatePaneDown",
            "alt-f h": "workspace::ActivatePaneLeft",
            "alt-f l": "workspace::ActivatePaneRight",
            "alt-f t": "workspace::ToggleBottomDock",
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "alt-f z": "workspace::ToggleZoom",
            "alt-f d": "workspace::ToggleRightDock",
            // "alt-j": "terminal_panel::ToggleFocus",
            "alt-f w": "tab_switcher::Toggle",
            "alt-h": "pane::ActivatePreviousItem",
            "alt-l": "pane::ActivateNextItem",
            "alt-f |": "pane::SplitRight",
            "alt-f -": "pane::SplitDown",
            "ctrl-enter": "editor::NewlineBelow",
            "ctrl-m": "editor::MoveToEnclosingBracket",
        }
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            "ctrl-enter": "editor::NewlineBelow",
            "ctrl-d": "editor::SelectNext"
        }
    },
    {
        "context": "VimControl && !menu",
        "bindings": {
            "alt-n": "vim::ScrollDown",
            "alt-u": "vim::ScrollUp",
        }
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "alt-f d": "workspace::ToggleRightDock"
        }
    },
    {
        "context": "TabSwitcher",
        "bindings": {
            "j": "menu::SelectNext",
            "k": "menu::SelectPrevious",
            "x": "tab_switcher::CloseSelectedItem"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            // "alt-k": "terminal_panel::ToggleFocus"
        }
    },
    // from https://github.com/zed-industries/zed/discussions/11474
    {
        "context": "Editor && showing_completions",
        "bindings": {
            "enter": "editor::Newline",
            "escape": "editor::Cancel",
            "shift enter": "editor::ConfirmCompletion",
            "tab": "editor::Tab"
        }
    }
]
