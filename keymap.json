// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            "alt-o": "file_finder::Toggle",
            "alt-f o": [
                "projects::OpenRecent",
                {
                    "create_new_window": false
                }
            ],
            "alt-k": [
                "workspace::ActivatePaneInDirection",
                "Up"
            ],
            "alt-j": [
                "workspace::ActivatePaneInDirection",
                "Down"
            ],
            "alt-f h": [
                "workspace::ActivatePaneInDirection",
                "Left"
            ],
            "alt-f l": [
                "workspace::ActivatePaneInDirection",
                "Right"
            ],
            "alt-f t": "workspace::ToggleBottomDock",
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "alt-f z": "workspace::ToggleZoom",
            "alt-f d": "workspace::ToggleRightDock",
            // "alt-j": "terminal_panel::ToggleFocus",
            "alt-f w": "tab_switcher::Toggle",
            "alt-h": "pane::ActivatePrevItem",
            "alt-l": "pane::ActivateNextItem",
            "alt-f |": "pane::SplitRight",
            "alt-f -": "pane::SplitDown"
        }
    },
    {
        "context": "VimControl && !menu",
        "bindings": {
            "alt-n": "vim::ScrollDown",
            "alt-u": "vim::ScrollUp",
        }
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "alt-f d": "workspace::ToggleRightDock"
        }
    },
    {
        "context": "TabSwitcher",
        "bindings": {
            "j": "menu::SelectNext",
            "k": "menu::SelectPrev",
            "x": "tab_switcher::CloseSelectedItem"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            // "alt-k": "terminal_panel::ToggleFocus"
        }
    }
]
