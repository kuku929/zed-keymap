// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            "alt-o": "file_finder::Toggle",
            "alt-f o": [
                "projects::OpenRecent",
                {
                    "create_new_window": false
                }
            ],
            "alt-l": [
                "workspace::ActivatePaneInDirection",
                "Right"
            ],
            "alt-h": [
                "workspace::ActivatePaneInDirection",
                "Left"
            ],
            "alt-f z": "workspace::CloseAllDocks",
            "alt-f h": "workspace::ToggleLeftDock",
            "alt-f l": "workspace::ToggleRightDock"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "alt-f w": "tab_switcher::Toggle",
            "alt-j": "tab_switcher::Toggle",
            // "alt-k": "tab_switcher::Toggle",
            "alt-f |": "pane::SplitRight",
            "alt-f -": "pane::SplitDown",
            "ctrl-enter": "editor::NewlineBelow",
            "ctrl-m": "editor::MoveToEnclosingBracket"
        }
    },
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "alt-f l": "workspace::ToggleLeftDock"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            "alt-f h": "workspace::ToggleRightDock"
        }
    },
    {
        "context": "VimControl && !menu",
        "bindings": {
            "alt-n": "vim::ScrollDown",
            "alt-u": "vim::ScrollUp"
        }
    },
    {
        "context": "TabSwitcher",
        "bindings": {
            "alt-j": "menu::SelectNext",
            "alt-k": "menu::SelectPrev",
            "alt-x": "tab_switcher::CloseSelectedItem",
            "j": "menu::SelectNext",
            "k": "menu::SelectPrev",
            "x": "tab_switcher::CloseSelectedItem"
        }
    },
    // from https://github.com/zed-industries/zed/discussions/11474
    {
        "context": "Editor && showing_completions",
        "bindings": {
            "enter": "editor::Newline",
            "escape": "editor::Cancel",
            "shift-enter": "editor::ConfirmCompletion",
            "tab": "editor::Tab"
        }
    }
]
