{
    // Ctrl+c Ctrl+v settings---
    "features": {
        "inline_completion_provider": "none"
    },
    "cursor_blink": false,
    "relative_line_numbers": true,
    "scrollbar": {
        "show": "never"
    },
    "scroll_beyond_last_line": "off",
    "vertical_scroll_margin": 0,
    "gutter": {
        "line_numbers": true,
        "folds": false,
        "runnables": false,
        "code_actions": false
    },
    "tab_bar": {
        "show": false
    },
    //-------------------------
    "current_line_highlight": "gutter",
    "terminal": {
        "dock": "right"
    },
    "project_panel": {
        "dock": "left"
    },
    "git": {
        "git_gutter": "hide",
        "inline_blame": null,
        "gutter_debounce": 0
    },
    "chat_panel": {
        "button": false,
        "dock": null
    },
    "notification_panel": {
        "button": false
    },
    "assistant": {
        "version": "1",
        "button": false,
        "dock": "bottom"
    },
    "collaboration_panel": {
        "button": false
    },
    "base_keymap": "SublimeText",
    "theme": "Kanagawa Dragon",
    "autosave": "on_focus_change",
    "vim_mode": true,
    "hard_tabs": false,
    "tab_size": 4,
    "formatter": "auto",
    "indent_guides": {
        "active_line_width": 2
    },
    "prettier": {
        "tabWidth": 2,
        "useTabs": false
    },
    "remove_trailing_whitespace_on_save": false,
    "always_treat_brackets_as_autoclosed": true,
    "languages": {
        "Python": {
            "show_whitespaces": "selection",
            "hard_tabs": false,
            "tab_size": 4,
            "format_on_save": "off",
            "language_servers": [
                "ruff"
            ],
            "formatter": {
                "language_server": {
                    "name": "ruff"
                }
            }
        },
        "C++": {
            "hard_tabs": false,
            "formatter": {
                "external": {
                    "command": "/usr/bin/clang-format",
                    "arguments": [
                        "--style={BasedOnStyle: Microsoft, ColumnLimit: 100}",
                        "-",
                        "--assume-filename={buffer_path}",
                        "--function-arg-placeholders=0"
                    ]
                }
            },
            "format_on_save": "off"
        }
    },
    "experimental.theme_overrides": {},
    "ui_font_size": 16,
    "buffer_font_size": 17,
    "buffer_line_height": "standard"
}
